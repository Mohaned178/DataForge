{
  "name": "@dataforge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line interface for generating, verifying, chaos-planning, delivering (in process or through Kafka) and validating DataForge simulation runs.",
  "main": "./dist/main.js",
  "bin": {
    "dataforge": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@dataforge/chaos": "workspace:*",
    "@dataforge/core": "workspace:*",
    "@dataforge/execution": "workspace:*",
    "@dataforge/kafka": "workspace:*",
    "@dataforge/targets": "workspace:*",
    "@dataforge/validation": "workspace:*",
    "zod": "4.6.7"
  }
}
