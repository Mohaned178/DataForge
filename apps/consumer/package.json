{
  "name": "@dataforge/consumer",
  "version": "0.1.0",
  "private": true,
  "description": "The reference consumer as a standalone process: reads DataForge delivery records from Kafka, runs a reference target and writes its actual state.",
  "main": "./dist/main.js",
  "bin": {
    "dataforge-consumer": "./dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@dataforge/core": "workspace:*",
    "@dataforge/kafka": "workspace:*",
    "@dataforge/targets": "workspace:*"
  }
}
