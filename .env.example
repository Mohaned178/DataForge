# DataForge environment configuration. Copy to .env to change a value; real environment
# variables take precedence over .env.

# Kafka broker(s) that "dataforge deliver --transport kafka", the consumer and the API's Kafka test
# executions connect to (comma-separated host:port). Overridden by --brokers on the command line.
KAFKA_BROKERS=localhost:9092

# Host port on which "docker compose" publishes the broker. Change KAFKA_BROKERS with it.
KAFKA_HOST_PORT=9092

# PostgreSQL database of the API and of "pnpm db:migrate" (the Compose service by default).
DATABASE_URL=postgresql://dataforge:dataforge@localhost:5433/dataforge

# Host port on which "docker compose" publishes PostgreSQL. Change DATABASE_URL with it.
POSTGRES_HOST_PORT=5433

# Address and port the API listens on ("pnpm api"). 127.0.0.1 keeps it on this machine: the API
# has no authentication.
API_HOST=127.0.0.1
API_PORT=3000

# Where the API keeps, per Kafka test execution, the consumer's output and the Kafka client logs
# (an absolute path). Unset: dataforge-executions in the system temp directory.
# EXECUTION_WORK_DIR=C:\dataforge\executions

# Database the integration tests (pnpm test:integration) drop, recreate and migrate on every run.
# Its name must end in "_test".
TEST_DATABASE_URL=postgresql://dataforge:dataforge@localhost:5433/dataforge_test
