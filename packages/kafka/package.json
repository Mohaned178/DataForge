{
  "name": "@dataforge/kafka",
  "version": "0.1.0",
  "private": true,
  "description": "Kafka delivery: the record contract, the plan executor, consumer-group lag and the consumer runner. The only package that imports a Kafka client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@dataforge/chaos": "workspace:*",
    "@dataforge/core": "workspace:*",
    "@dataforge/targets": "workspace:*",
    "kafkajs": "2.2.4",
    "zod": "4.6.7"
  }
}
