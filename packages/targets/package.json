{
  "name": "@dataforge/targets",
  "version": "0.1.0",
  "private": true,
  "description": "Reference target pipelines (correct and naive) and the in-memory transport that delivers a plan to them.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@dataforge/chaos": "workspace:*",
    "@dataforge/core": "workspace:*"
  }
}
