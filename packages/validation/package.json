{
  "name": "@dataforge/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic validation engine: compares a target's actual state with the expected state and explains each finding by delivery faults.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@dataforge/chaos": "workspace:*",
    "@dataforge/core": "workspace:*"
  },
  "devDependencies": {
    "@dataforge/targets": "workspace:*"
  }
}
