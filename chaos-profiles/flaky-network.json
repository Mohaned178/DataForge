{
  "formatVersion": 1,
  "name": "flaky-network",
  "description": "All four fault types at once, with retries that always succeed in the end (no loss).",
  "faults": {
    "delay": { "rate": 0.1, "delayMs": { "min": 1000, "max": 600000 } },
    "reorder": { "rate": 0.05, "distance": { "min": 1, "max": 3 } },
    "duplicate": { "rate": 0.05, "copies": { "min": 1, "max": 2 }, "redeliveryOffsetMs": { "min": 0, "max": 120000 } },
    "transientFailure": {
      "rate": 0.05,
      "failures": { "min": 1, "max": 2 },
      "maxRetries": 3,
      "retryBackoffMs": { "min": 1000, "max": 30000 },
      "allowLoss": false
    }
  }
}
